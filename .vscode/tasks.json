{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build ThermalSense",
            "command": "${workspaceFolder}\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/c"] }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile all sources in src/ into ThermalSense.exe"
        }
    ]
}
