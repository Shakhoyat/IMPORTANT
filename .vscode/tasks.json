{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build ThermalSense",
            "command": "./build.sh",
            "windows": {
                "command": "${workspaceFolder}\\build.bat",
                "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "cmd.exe", "args": ["/c"] } }
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Windows: build.bat (MinGW). Linux: build.sh (make; add --headless for EGL only)"
        }
    ]
}
